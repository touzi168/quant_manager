version: '3.8'

services:
  # 后端服务
  backend:
    build:
      context: ./backend
      dockerfile: Dockerfile
    ports:
      - "6666:6666"
    environment:
      - NODE_ENV=production
      - DB_HOST=mariadb
      - DB_PORT=3306
      - DB_NAME=bquant
      - DB_USER=root
      - DB_PASSWORD=Zjhdb123.
      - REDIS_HOST=redis
      - REDIS_PORT=6379
    depends_on:
      - mariadb
      - redis
    volumes:
      - ./backend/logs:/app/logs
    restart: unless-stopped

  # 前端服务
  frontend:
    build:
      context: ./frontend
      dockerfile: Dockerfile
    ports:
      - "7777:80"
    depends_on:
      - backend
    restart: unless-stopped

  # MariaDB数据库
  mariadb:
    image: mariadb:11.6.2
    environment:
      MYSQL_ROOT_PASSWORD: Zjhdb123. 
      MYSQL_DATABASE: bquant
    volumes:
      - mariadb_data:/var/lib/mysql
    ports:
      - "3306:3306"
    restart: unless-stopped

  # Redis缓存
  redis:
    image: redis:7-alpine
    ports:
      - "6379:6379"
    volumes:
      - redis_data:/data
    restart: unless-stopped

volumes:
  mariadb_data:
  redis_data:

